// App database. Conventions (CONVENTIONS.md): one model per entity, each with id, createdAt and
// updatedAt; every schema change comes with a migration in prisma/migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // No `url`: migrate commands read it from prisma.config.ts, and the app connects through the
  // @prisma/adapter-pg driver adapter (src/lib/db.ts).
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role      @default(MEMBER)
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
